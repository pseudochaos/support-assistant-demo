# Copy to .env and fill in. Never commit .env.

# Model as "<provider>:<model id>" (LangChain init_chat_model format).
# Check current model ids in the provider docs before changing.
ASSISTANT_MODEL=google_genai:gemini-3.5-flash-lite
GOOGLE_API_KEY=

# Free-tier alternative with a much larger daily quota, but slow under load:
# ASSISTANT_MODEL=google_genai:gemma-4-31b-it

# Other providers (install the extra first: uv sync --extra anthropic / --extra openai):
# ASSISTANT_MODEL=anthropic:<model id>
# ANTHROPIC_API_KEY=
# ASSISTANT_MODEL=openai:<model id>
# OPENAI_API_KEY=

# Optional: prices in USD per 1M tokens to estimate cost. Take them from the
# provider's pricing page; without them only token counts are shown.
# PRICE_INPUT_PER_MTOK=
# PRICE_OUTPUT_PER_MTOK=

# Seconds to wait for one model request, and how many times to retry it.
# MODEL_TIMEOUT=60
# MODEL_MAX_RETRIES=2

# Where approved tickets are written.
# TICKETS_FILE=tickets.jsonl

# Optional, only for LangGraph Studio (needs a LangSmith account).
# Without LANGSMITH_TRACING=false runs are traced to LangSmith.
# LANGSMITH_API_KEY=
# LANGSMITH_TRACING=false
